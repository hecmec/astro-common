{
  "name": "astro-common",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm -r run check",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @babelcoach/comments-widget run build && pnpm --filter @babelcoach/comments-service run dev",
    "test:e2e": "pnpm --filter @babelcoach/comments-service run test:e2e"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
