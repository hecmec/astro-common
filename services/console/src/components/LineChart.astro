---
// Line chart drawn as inline SVG on the server (design: "Charts are inline SVG").
// Each point carries a <title> (site, day, value) so hovering works without scripts;
// /chart.js adds a crosshair tooltip when scripts run.
import { type ChartInput, buildChart } from '../lib/chart.ts';
import { shortDay } from '../lib/dates.ts';

interface Props {
  input: ChartInput;
  /** Accessible title, e.g. "Daily visitors per site, last 30 days". */
  title: string;
}
const { input, title } = Astro.props;
const g = buildChart(input);
const last = g.columns.length - 1;
const data = JSON.stringify({
  columns: g.columns,
  days: input.days.map(shortDay),
  unit: input.unit,
  series: input.series.filter((s) => s.values).map((s) => ({ name: s.name, color: s.color, values: s.values })),
});
---

<figure class="relative" data-chart-figure>
  <svg viewBox={`0 0 ${g.width} ${g.height}`} class="h-auto w-full" role="img" aria-label={title} data-chart={data}>
    <title>{title}</title>
    <g data-grid>
      {
        g.yTicks.map((t) => (
          <>
            <line x1={g.plot.left} x2={g.plot.right} y1={t.y} y2={t.y} stroke="var(--grid)" stroke-width="1" />
            <text x={g.plot.left - 8} y={t.y} dy="0.32em" text-anchor="end" font-size="12" fill="var(--muted)">
              {t.label}
            </text>
          </>
        ))
      }
      {
        g.xLabels.map((l) => (
          <text x={l.x} y={g.plot.bottom + 20} text-anchor="middle" font-size="12" fill="var(--muted)">
            {l.label}
          </text>
        ))
      }
    </g>
    <line data-crosshair x1="0" x2="0" y1={g.plot.top} y2={g.plot.bottom} stroke="var(--muted)" stroke-width="1" visibility="hidden" />
    {
      g.lines.map((l) => (
        <polyline points={l.points} fill="none" stroke={l.color} stroke-width="2" stroke-linejoin="round" stroke-linecap="round" data-line={l.id} />
      ))
    }
    {
      g.endLabels.map((e) => (
        <>
          {e.leader && <line x1={g.plot.right + 5} y1={e.lineY} x2={e.x - 3} y2={e.y} stroke="var(--muted)" stroke-width="1" />}
          <text x={e.x} y={e.y} dy="0.32em" font-size="12" font-weight="600" fill="var(--fg-soft)" data-end-label={e.id}>
            {e.text}
          </text>
        </>
      ))
    }
    {
      g.dots.map((d, i) => (
        <g class="chart-point" data-point={d.id}>
          <title>{d.title}</title>
          <circle cx={d.x} cy={d.y} r="8" fill="transparent" />
          <circle
            class:list={['chart-dot', i % g.columns.length === last && 'chart-dot-end']}
            cx={d.x}
            cy={d.y}
            r="4"
            fill={d.color}
            stroke="var(--surface)"
            stroke-width="2"
          />
        </g>
      ))
    }
  </svg>
  <div data-chart-tooltip hidden class="pointer-events-none absolute z-10 rounded-md border border-(--line) bg-(--surface) px-3 py-2 text-xs shadow-md"></div>
</figure>

<style>
  /* Dots appear on hover; the last day's dot always shows (end marker). */
  .chart-dot {
    opacity: 0;
  }
  .chart-dot-end,
  .chart-point:hover .chart-dot {
    opacity: 1;
  }
</style>
