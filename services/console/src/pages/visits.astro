---
// Visits page (spec console-visits): the four sites in one chart, 7/30/90 days,
// visitors or pageviews, totals as legend, a table view.
import ChoiceNav from '../components/ChoiceNav.astro';
import DailyTable from '../components/DailyTable.astro';
import LineChart from '../components/LineChart.astro';
import SiteTotals from '../components/SiteTotals.astro';
import Console from '../layouts/Console.astro';
import { getContext } from '../lib/context.ts';
import { RANGES, type Range, parseRange } from '../lib/ranges.ts';
import { METRICS, type Metric, parseMetric } from '../lib/visits.ts';

const { visits } = getContext();
const range = parseRange(Astro.url.searchParams.get('range'));
const metric = parseMetric(Astro.url.searchParams.get('metric'));
const data = await visits.get(range, metric);
if (data.unavailable) Astro.response.status = 503;

const UNITS: Record<Metric, [string, string]> = { visitors: ['visitor', 'visitors'], pageviews: ['pageview', 'pageviews'] };
const LABELS: Record<Metric, string> = { visitors: 'Visitors', pageviews: 'Pageviews' };
const href = (r: Range, m: Metric) => `/visits?${new URLSearchParams({ range: String(r), metric: m })}`;
const chartInput = {
  days: data.days,
  unit: UNITS[metric],
  series: data.series.map((s) => ({ id: s.site.id, name: s.site.name, short: s.site.short, color: `var(--site-${s.site.id})`, values: s.values })),
};
const title = `Daily ${metric} per site, last ${range} days (Europe/Paris)`;
---

<Console title="Visits" current="visits">
  <h1 class="mb-4 text-2xl font-bold">Visits</h1>

  <div class="mb-4 flex flex-wrap items-center gap-4" data-controls>
    <ChoiceNav label="Range" items={RANGES.map((r) => ({ href: href(r, metric), label: `${r} days`, current: r === range, data: ['range', String(r)] }))} />
    <ChoiceNav label="Metric" items={METRICS.map((m) => ({ href: href(range, m), label: LABELS[m], current: m === metric, data: ['metric', m] }))} />
  </div>

  {
    data.unavailable ? (
      <p class="notice notice-error" role="alert" data-unavailable>
        Visit statistics are unavailable.
      </p>
    ) : (
      <>
        {data.failed.length > 0 && (
          <p class="notice notice-error mb-4" role="status" data-failed>
            No statistics for {data.failed.map((s) => s.name).join(', ')} right now; the other sites are shown.
          </p>
        )}
        <section class="card">
          <LineChart input={chartInput} title={title} />
          <SiteTotals label={`Totals over ${range} days`} series={data.series} />
        </section>
        <p class="mt-3 text-sm text-(--fg-soft)" data-note>
          {metric === 'visitors'
            ? 'Visitors are Umami visits: a person counts once per visit, so the total over a period counts returning people again. Days are calendar days in Paris time; today is counted so far.'
            : 'Pageviews are every page loaded on the site. Days are calendar days in Paris time; today is counted so far.'}{' '}
          Figures are at most 5 minutes old.
        </p>
        <DailyTable days={data.days} series={data.series} />
      </>
    )
  }
  <script is:inline src="/chart.js" defer></script>
</Console>
