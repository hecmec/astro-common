---
// Links page: the four sites on staging and in production, and a button per environment
// that opens all four in new tabs (/links.js; the links work on their own without it).
import SiteBadge from '../components/SiteBadge.astro';
import Console from '../layouts/Console.astro';
import { getContext } from '../lib/context.ts';

const { sites } = getContext();
const environments = [
  { id: 'staging', title: 'Staging', note: 'Built from develop; not indexed.', host: (s: (typeof sites)[number]) => s.staging },
  { id: 'production', title: 'Production', note: 'Built from main.', host: (s: (typeof sites)[number]) => s.domain },
];
---

<Console title="Links" current="links">
  <h1 class="mb-4 text-2xl font-bold">Links</h1>

  <div class="grid gap-4 md:grid-cols-2">
    {
      environments.map((env) => {
        const links = sites.map((s) => ({ site: s, url: `https://${env.host(s)}/` }));
        return (
          <section class="card flex flex-col gap-3" aria-labelledby={`env-${env.id}`} data-env={env.id}>
            <div class="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h2 id={`env-${env.id}`} class="text-lg font-semibold">
                  {env.title}
                </h2>
                <p class="text-sm text-(--fg-soft)">{env.note}</p>
              </div>
              <button type="button" class="btn" data-open-all={JSON.stringify(links.map((l) => l.url))} hidden>
                Open all 4
              </button>
            </div>
            <ul class="flex flex-col gap-2">
              {links.map((l) => (
                <li class="flex flex-wrap items-center justify-between gap-2 rounded-md border border-(--line) px-3 py-2" data-link={l.site.id}>
                  <SiteBadge site={l.site} />
                  <a href={l.url} target="_blank" rel="noopener" class="text-sm underline decoration-(--line) underline-offset-2 hover:decoration-current">
                    {env.host(l.site)}
                  </a>
                </li>
              ))}
            </ul>
            <p class="text-sm text-(--danger)" data-blocked hidden />
          </section>
        );
      })
    }
  </div>
  <script is:inline src="/links.js" defer></script>
</Console>
